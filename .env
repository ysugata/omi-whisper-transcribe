# Omi Whisper Bridge 環境変数
# このファイルを .env にコピーして使用

# --- 認証設定 ---
# 認証トークン (Cloudflare Tunnel 経由で公開する場合は必須)
# 以下のコマンドで生成:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 空のままだと認証なし (LAN内専用モード)
OMI_WHISPER_TOKEN=DJw_kG2otik2nO1emZfd0NQ-2FFI4ec9sKT3KwoM-SauowRR8ICnN6whXk_0MyUS

# --- Whisper モデル設定 ---
# WHISPER_MODEL=large-v3          # tiny, base, small, medium, large-v3
# COMPUTE_TYPE=int8_float16       # float16, int8_float16, int8
# LANGUAGE=ja                     # ja, en, auto (auto=自動検出)
# BEAM_SIZE=5
# VAD_FILTER=true                 # 無音区間のハルシネーション対策

# --- サーバー設定 ---
# HOST=0.0.0.0
# PORT=8090                       # 変更時は docker-compose.yml の ports も合わせること
# BUFFER_SECONDS=3.0              # 音声をバッファする秒数

# --- GPU 共有設定 (qwen-tts との自動切り替え) ---
# GPU_IDLE_TIMEOUT_MINUTES=5      # 全セッション切断後、GPU を解放するまでの待機分数
# QWEN_TTS_CONTAINER=qwen-tts-api-qwen-tts-api-1  # qwen-tts の Docker コンテナ名
# DOCKER_STOP_TIMEOUT=30          # docker stop のタイムアウト秒数

# --- 録音保存設定 ---
# SAVE_AUDIO=true                 # false で録音保存を無効化
# RECORDINGS_DIR=./recordings
# MAX_RECORDING_DAYS=30           # 0 で自動削除を無効化
