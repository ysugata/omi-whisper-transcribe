# Omi Whisper Bridge 環境変数
# このファイルを .env にコピーして使用

# --- 認証設定 ---
# 認証トークン (Cloudflare Tunnel 経由で公開する場合は必須)
# 以下のコマンドで生成:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 空のままだと認証なし (LAN内専用モード)
OMI_WHISPER_TOKEN=

# --- Whisper モデル設定 ---
# WHISPER_MODEL=large-v3          # tiny, base, small, medium, large-v3
# COMPUTE_TYPE=int8_float16       # float16, int8_float16, int8
# LANGUAGE=ja                     # ja, en, auto (auto=自動検出)
# BEAM_SIZE=5
# VAD_FILTER=true                 # 無音区間のハルシネーション対策

# --- サーバー設定 ---
# HOST=0.0.0.0
# PORT=8090                       # 変更時は docker-compose.yml の ports も合わせること
# BUFFER_SECONDS=3.0              # 音声をバッファする秒数

# --- GPU 共有設定 (qwen-tts との自動切り替え) ---
# GPU_IDLE_TIMEOUT_MINUTES=5      # 全セッション切断後、GPU を解放するまでの待機分数
# QWEN_TTS_CONTAINER=qwen-tts-api-qwen-tts-api-1  # qwen-tts の Docker コンテナ名
# DOCKER_STOP_TIMEOUT=30          # docker stop のタイムアウト秒数

# --- API キー ---
GEMINI_API_KEY=                     # Gemini API (LLM 補正、タグ付け、サニタイズ)
OPENAI_API_KEY=                     # OpenAI API (SANITIZE_MODEL=gpt-5-nano 使用時)
HF_AUTH_TOKEN=                      # HuggingFace (話者分離、声紋)

# --- サニタイズ設定 ---
# SANITIZE_MODEL=gemini-2.5-flash    # gemini-2.5-flash | gpt-5-nano
# SANITIZE_USE_RESPONSES_API=auto    # auto (gpt-* なら有効) | true | false
# OPENAI_REASONING_EFFORT=low        # none | minimal | low | medium | high | xhigh
# OPENAI_MAX_OUTPUT_TOKENS=1800      # Responses API の max_output_tokens
# OPENAI_TIMEOUT_MS=60000            # Responses API タイムアウト (ms)
# OPENAI_MODEL=gpt-5-nano            # tools/sanitize_jsonl.py 用

# --- 録音保存設定 ---
# SAVE_AUDIO=true                 # false で録音保存を無効化
# RECORDINGS_DIR=./recordings
# MAX_RECORDING_DAYS=30           # 0 で自動削除を無効化
