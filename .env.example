# Omi Whisper Bridge 環境変数
# このファイルを .env にコピーして使用。
# ここに載っていない変数の一覧とデフォルト値は README.md の「環境変数」を参照。

# --- 認証設定 ---
# 認証トークン (Cloudflare Tunnel 経由で公開する場合は必須)
# 以下のコマンドで生成:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 空のままだと認証なし (LAN内専用モード)
OMI_WHISPER_TOKEN=

# 管理 API (8091) の認証トークン (任意)。設定すると全管理エンドポイントで
# Authorization: Bearer <token> (または ?token=) が必須になる。
# Viewer には同じ値が自動で渡る (docker-compose)。空 = 認証なし (従来どおり)
MANAGEMENT_TOKEN=

# --- API キー ---
GEMINI_API_KEY=                     # Gemini API (LLM 補正、タグ付け、サニタイズ)
OPENAI_API_KEY=                     # OpenAI API (SANITIZE_MODEL=gpt-5-nano / 事業継承 RAG)
HF_AUTH_TOKEN=                      # HuggingFace (話者分離、声紋)

# --- ASR エンジン ---
# ENGINE=whisper                  # whisper | qwen3asr
# WHISPER_MODEL=large-v3          # tiny, base, small, medium, large-v3
# COMPUTE_TYPE=int8_float16       # float16, int8_float16, int8
# LANGUAGE=ja                     # ja, en, auto (auto=自動検出)
# BEAM_SIZE=5
# VAD_FILTER=true                 # 無音区間のハルシネーション対策
# BUFFER_SECONDS=5.0              # VAD 無効時の固定チャンク秒数

# --- サーバー設定 ---
# HOST=0.0.0.0
# PORT=8090                       # 変更時は docker-compose.yml の ports も合わせること
# MANAGEMENT_PORT=8091            # 管理 API ポート
# VIEWER_PORT=8092                # Viewer ポート

# --- VAD セグメンテーション ---
# VAD_SEG_ENABLED=true            # Silero VAD による発話区間セグメンテーション
# VAD_SILENCE_TRIGGER=1.2         # 文字起こしトリガーとなる無音秒数
# VAD_MAX_BUFFER=20.0             # 強制文字起こしまでの最大バッファ秒数
# SILENCE_TIMEOUT=30.0            # セッション終了とみなす無音秒数

# --- LLM 後処理 / セッションタグ ---
# LLM_ENABLED=true
# LLM_MODEL=gemini-3.1-flash-lite
# LLM_PIPELINE_STAGES=AB          # A=候補抽出, B=補正, C=監査
# LLM_BATCH_MODE=sync             # sync | batch (Gemini Batch API 50%割引)
# TAGGING_ENABLED=true
# TAGGING_MODEL=gemini-3.1-flash-lite
# RAG_ENABLED=true                # RAG 分類 (LLM コスト削減)

# --- 話者分離 / 声紋 ---
# DIARIZATION_ENABLED=false       # セッション終了時の自動話者分離
# VOICE_FILTER_ENABLED=false      # リアルタイム声紋フィルタ (非ユーザー音声除去)

# --- 音響シーン分類 ---
# AUDIO_SCENE_ENABLED=true        # PANNs CNN14 (CPU 推論)
# AUDIO_SCENE_THRESHOLD=0.3

# --- 深夜バッチ ---
# NIGHTLY_SCHEDULE_HOUR=4         # 0=無効, 1-23=実行時刻
# BATCH_MAX_DAYS=7                # バッチ走査対象日数 (0=無制限)

# --- サニタイズ設定 ---
# SANITIZE_MODEL=gemini-2.5-flash    # gemini-2.5-flash | gpt-5-nano
# SANITIZE_USE_RESPONSES_API=auto    # auto (gpt-* なら有効) | true | false
# OPENAI_REASONING_EFFORT=low        # none | minimal | low | medium | high | xhigh
# OPENAI_MAX_OUTPUT_TOKENS=1800      # Responses API の max_output_tokens
# OPENAI_TIMEOUT_MS=60000            # Responses API タイムアウト (ms)
# OPENAI_MODEL=gpt-5-nano            # tools/sanitize_jsonl.py 用

# --- 事業継承 RAG / LLM Wiki ---
# SUCCESSION_ANSWER_MODEL=gpt-5-nano
# SUCCESSION_EMBED_MODEL=gemini-embedding-001
# KNOWLEDGE_DIR=/home/dev/knowledge  # ホスト側 knowledge repo のパス (docker-compose)

# --- 録音保存設定 ---
# SAVE_AUDIO=true                 # false で録音保存を無効化
# RECORDINGS_DIR=./recordings
# MAX_RECORDING_DAYS=30           # 0 で自動削除を無効化

# --- GPU 共有設定 (qwen-tts との自動切り替え、レガシー) ---
# GPU_IDLE_TIMEOUT_MINUTES=5      # 全セッション切断後、GPU を解放するまでの待機分数
# QWEN_TTS_CONTAINER=qwen-tts-api-qwen-tts-api-1  # qwen-tts の Docker コンテナ名
# DOCKER_STOP_TIMEOUT=30          # docker stop のタイムアウト秒数
